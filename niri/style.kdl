// Merge this layout block into your EXISTING layout block.
// Keep your existing monitor, input, binds and DMS include configuration.
layout {
    gaps 12
    background-color "#090a0f"
    focus-ring {
        width 2
        active-color "#ef4454"
        inactive-color "#65b8ff"
    }
    border { off; }
    shadow {
        on
        softness 28
        spread 3
        offset x=0 y=6
        color "#00000099"
    }
}

// Add these to your existing general window-rule, or add this block once.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}
