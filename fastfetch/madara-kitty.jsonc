{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/sharingan.png",
    "width": 24,
    "height": 12,
    "padding": {
      "right": 4,
      "top": 1
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "title": "red"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "wm",
    "terminal",
    "shell",
    "uptime",
    "break",
    "colors"
  ]
}
